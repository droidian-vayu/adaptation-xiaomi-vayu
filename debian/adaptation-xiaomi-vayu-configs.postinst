#!/bin/sh
 
#set -e
 
MAIN_LOG_DIR="/var/log/droidian-adaptation"

## Revert squeekboard delay fix
[ -e "/usr/bin/squeekboard2" -a ! -e "/usr/bin/squeekboard" ] \
        && cp -av /usr/bin/squeekboard2 /usr/bin/squeekboard
 
for profile in $(find /home -name ".profile"); do   
    ## Clean squeekboard delay fix from .profile
    squeek_enabled=$(cat $profile | grep squeekboard2)
    if [ -n "${squeek_enabled}" ]; then
        sed -i '/## Call SqueekBoard/d' ${profile}
        sed -i '/.*sleep 10 && .*squeekboard2.*/d' ${profile}
    fi
    ## Clean rmnet delay fix from .profile
    rmnet_fix_enabled=$(cat $profile | grep "droidian-adapt-fix-rmnet-con-delayed.sh")
    if [ -n "${rmnet_fix_enabled}" ]; then
        sed -i '/## Fix rmnet connection/d' ${profile}
        sed -i '/(sleep 10 && /usr/bin/droidian-adapt-fix-rmnet-con-delayed.sh) &/d' ${profile}
    fi
done

## Add droidian user to android_camera group. It help cameras and need for torch switch and control.
## This may not create a security issue since droidian user already has access to cameras.
if getent group android_camera >/dev/null 2>&1; then
    adduser droidian android_camera
fi

## Remove the clear_console when we exit an ssh session. 
## We don't have physical console so it not cause privacy issue.
FILE="/home/droidian/.bash_logout"

# Original text to search for
OLD_TEXT=$(cat <<'EOF'
if [ "$SHLVL" = 1 ]; then
    [ -x /usr/bin/clear_console ] && /usr/bin/clear_console -q
fi
EOF
)

# Replacement text
NEW_TEXT=$(cat <<'EOF'
#if [ "$SHLVL" = 1 ]; then
#    [ -x /usr/bin/clear_console ] && /usr/bin/clear_console -q
#fi
EOF
)
# Replace the exact block with the commented block
OLD_TEXT="$OLD_TEXT" NEW_TEXT="$NEW_TEXT" perl -0pi -e '
    BEGIN {
        $old = $ENV{"OLD_TEXT"};
        $new = $ENV{"NEW_TEXT"};
    }
    s/\Q$old\E/$new/;
' "$FILE"

## PROVISIONAL : Add commit : 825b34943b22e37a0f613f09fcd25d394b95a74b in usr/sbin/mount-android.sh
## We need this commit but it is not include in lxc-android for now
## https://github.com/droidian/lxc-android/commit/825b34943b22e37a0f613f09fcd25d394b95a74b
## To remove with lxc-android > 1:39+git20250906140358
FILE="/usr/sbin/mount-android.sh"

# Block to search for - 1
BLOCK=$(cat <<'EOF'
mount -t overlay overlay -o lowerdir=/usr/lib/droid-system-overlay:/var/lib/lxc/android/rootfs/system /var/lib/lxc/android/rootfs/system
EOF
)

# Line to add after the block - 1
ADD_LINE=$(cat <<'EOF'
        echo "overlayed on /var/lib/lxc/android/rootfs/system"
        if [ -d "/android/system" ]; then
            mount -t overlay overlay -o lowerdir=/usr/lib/droid-system-overlay:/android/system /android/system
            echo "overlayed on /android/system"
        fi
EOF
)

# Add the line after the block if it does not already exist - 1
BLOCK="$BLOCK" ADD_LINE="$ADD_LINE" perl -0pi -e '
    BEGIN {
        $block = $ENV{"BLOCK"};
        $line  = $ENV{"ADD_LINE"};
    }

    if (/\Q$block\E/) {
        $after_block = $+[0];

        # Check if the line exists immediately after the block
        $remaining = substr($_, $after_block);

        unless ($remaining =~ /\A(?:\r?\n)?\Q$line\E(?:\r?\n|\z)/) {
            substr($_, $after_block, 0) = "\n" . $line;
        }
    }
' "$FILE"

# Block to search for - 2
BLOCK=$(cat <<'EOF'
mount -t overlay overlay -o lowerdir=/var/lib/lxc/android/rootfs/system,upperdir=/usr/lib/droid-system-overlay,workdir=/var/lib/lxc/android/ /var/lib/lxc/android/rootfs/system
EOF
)

# Line to add after the block - 2
ADD_LINE=$(cat <<'EOF'
        echo "overlayed on /var/lib/lxc/android/rootfs/system"
        if [ -d "/android/system" ]; then
            mount -t overlay overlay -o lowerdir=/android/system,upperdir=/usr/lib/droid-system-overlay,workdir=/android/ /android/system
            echo "overlayed on /android/system"
        fi
EOF
)

# Add the line after the block if it does not already exist - 2
BLOCK="$BLOCK" ADD_LINE="$ADD_LINE" perl -0pi -e '
    BEGIN {
        $block = $ENV{"BLOCK"};
        $line  = $ENV{"ADD_LINE"};
    }

    if (/\Q$block\E/) {
        $after_block = $+[0];

        # Check if the line exists immediately after the block
        $remaining = substr($_, $after_block);

        unless ($remaining =~ /\A(?:\r?\n)?\Q$line\E(?:\r?\n|\z)/) {
            substr($_, $after_block, 0) = "\n" . $line;
        }
    }
' "$FILE"

exit 0
