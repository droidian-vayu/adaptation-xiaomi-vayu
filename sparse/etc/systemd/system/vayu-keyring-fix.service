[Unit]
Description=Fix keyring issue by deleting login.keyring on first boot
After=phosh.service
ConditionPathExists=!/lib/adaptation-xiaomi-vayu/initialized

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'sleep 15 && if [ -f "/home/droidian/.local/share/keyrings/login.keyring" ]; then mv /home/droidian/.local/share/keyrings/login.keyring /home/droidian/.local/share/keyrings/login.keyring.sav; systemctl disable vayu-keyring-fix.service; else systemctl disable vayu-keyring-fix.service; fi'
ExecStartPost=/usr/bin/touch /lib/adaptation-xiaomi-vayu/initialized

[Install]
WantedBy=multi-user.target
